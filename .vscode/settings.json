{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["enzyme-kinetics/tests"],
    "python.analysis.extraPaths": ["${workspaceFolder}/enzyme-kinetics/src"],
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/enzyme-kinetics/data/**": true,
        "**/enzyme-kinetics/vendor/**": true,
        "**/archive/downloads/**": true,
        "**/archive/git-metadata/**": true
    },
    "search.exclude": {
        "**/.venv/**": true,
        "enzyme-kinetics/data": true,
        "enzyme-kinetics/vendor": true,
        "enzyme-kinetics/outputs": true,
        "archive/downloads": true,
        "archive/git-metadata": true,
        "**/uv.lock": true
    }
}
